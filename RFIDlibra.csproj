<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>RFIDlibra</AssemblyName>
    <RootNamespace>RFIDlibra</RootNamespace>
    <Version>0.6.0</Version>
    <Product>RFIDlibra</Product>
    <Description>FEIG-læser til Cicero Mobile</Description>
    <ApplicationIcon>assets\RFIDlibra.ico</ApplicationIcon>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.ServiceProcess" />
    <EmbeddedResource Include="ui\index.html" LogicalName="index.html" />
  </ItemGroup>

</Project>
